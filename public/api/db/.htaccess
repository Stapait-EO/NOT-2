# Prevent directory browsing
Options -Indexes

# Set directory index to index.php
DirectoryIndex index.php

# Prevent direct access to any data/json files inside API directory
<FilesMatch "\.(json|jason|sql|log|txt|bak|lock|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
