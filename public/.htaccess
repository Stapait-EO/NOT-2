# Prevent directory browsing
Options -Indexes

# Set default directory index handlers
DirectoryIndex index.html index.php

# =======================================================
# SECURITY RULES
# Block direct HTTP access to JSON, SQL, LOG, ENV and backup files
# =======================================================
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|json|lock|env)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Explicit protection for any db.json files
<Files "db.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Explicit API routes: route directly to PHP handler with Query String Append
  RewriteRule ^api/db/?$ api/db/index.php [L,QSA]
  RewriteRule ^api/db\.php$ api/db/index.php [L,QSA]
  RewriteRule ^api/.*\.php$ - [L]

  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Fallback: send non-file requests to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . index.html [L]
</IfModule>
